load("//machine:python_tool.bzl", "python_test", "python_tool")

# Runs the spec's cases through TPC and writes each verdict into its case:
# bazel run //spec:record [-- case or directory ...]
python_tool(
    name = "record",
    data = [
        "//machine:disk",
        "//third_party/mtools",
        "//third_party/qemu:qemu-system-i386",
    ],
    fixed_args = [
        "--qemu=$(rootpath //third_party/qemu:qemu-system-i386)",
        "--mtools=$(rootpath //third_party/mtools)",
        "--disk=$(rootpath //machine:disk)",
    ],
    main = "record.py",
    srcs = [
        "cases.py",
        "//machine:probe.py",
        "//machine:qmp.py",
    ],
)

# Compares the cases' tokens with a capture of TPC's tokens:
# bazel run //spec:compare -- CAPTURED.json [--write]
python_tool(
    name = "compare",
    main = "compare.py",
    srcs = ["cases.py"],
)

# Checks that every case is well formed, recorded and cited by lexer.md, and
# that the real-value rules in lexer.md hold for the cases. Doesn't run TPC.
python_test(
    name = "cases_test",
    size = "small",
    data = [
        "case.schema.yaml",
        "lexer.md",
        "//spec/lexer:cases",
    ],
    main = "check_cases.py",
    srcs = ["cases.py"],
)

exports_files(["cases.py"])
