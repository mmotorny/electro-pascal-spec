# 1.189731495357231765e4932, one more in the 19th digit, is above the largest Extended value. The output is the constant's 80-bit Extended value in hex, most significant byte first.
tokens: PROGRAM IDENT(P) SEMI CONST IDENT(C) EQ
tpc: error 6 at 3:36
---
{$N+,E-}
program P;
const C = 1.189731495357231765e4932;
const H: array[0..15] of Char = '0123456789ABCDEF';
var X: Extended; B: array[0..9] of Byte absolute X; I: Integer;
begin X := C; for I := 9 downto 0 do Write(H[B[I] shr 4], H[B[I] and 15]) end.
