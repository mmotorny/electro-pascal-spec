# The same with a 41-character name: the ) doesn't end the comment.
tokens: PROGRAM IDENT(P) SEMI BEGIN IDENT(WRITE) LPAREN INTEGER(2) RPAREN END DOT
tpc: ok
output: '2'
---
program P;
{$DEFINE UUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUU}
(*$UNDEF UUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUU) begin Write(1) end. *)
begin Write(2) end.
