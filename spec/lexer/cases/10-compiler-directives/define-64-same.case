# Symbols that differ only in their 64th character are the same symbol.
tokens: PROGRAM IDENT(P) SEMI CONST IDENT(A) EQ INTEGER(1) SEMI BEGIN IDENT(WRITE) LPAREN IDENT(A) RPAREN END DOT
tpc: ok
output: '1'
---
program P;
{$DEFINE AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAB}
{$IFDEF AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAC} const A = 1; {$ENDIF}
begin Write(A) end.
