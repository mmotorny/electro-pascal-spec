# The same with (*$DEFINE ABCDEF): the ) doesn't end the comment.
tokens: PROGRAM IDENT(P) SEMI BEGIN IDENT(WRITE) LPAREN INTEGER(2) RPAREN END DOT
tpc: ok
output: '2'
---
program P;
{$DEFINE AXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX}
{$DEFINE BXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX}
{$DEFINE CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX}
(*$DEFINE ABCDEF) begin Write(1) end. *)
begin Write(2) end.
