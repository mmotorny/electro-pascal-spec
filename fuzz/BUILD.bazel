load("//machine:python_tool.bzl", "python_tool")

# Coverage-guided fuzzing of TPC, starting from the spec's cases:
# bazel run //fuzz -- --out DIR [--rounds N]
python_tool(
    name = "fuzz",
    data = [
        "//machine:disk",
        "//machine/coverage",
        "//third_party/mtools",
        "//third_party/qemu:qemu-system-i386",
    ],
    fixed_args = [
        "--qemu=$(rootpath //third_party/qemu:qemu-system-i386)",
        "--mtools=$(rootpath //third_party/mtools)",
        "--disk=$(rootpath //machine:disk)",
        "--coverage-plugin=$(rootpath //machine/coverage)",
    ],
    main = "fuzz.py",
    srcs = [
        "//machine:probe.py",
        "//machine:qmp.py",
        "//spec:cases.py",
    ],
)
