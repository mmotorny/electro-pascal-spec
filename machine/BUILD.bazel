load(":python_tool.bzl", "python_tool")

# The reference machine's hard disk: MS-DOS 6.22 and Borland Pascal 7.01,
# installed with default options by their own installers inside QEMU.
genrule(
    name = "disk",
    srcs = [
        "//third_party/bp701:archive",
        "//third_party/msdos622:archive",
    ],
    outs = ["disk.img"],
    visibility = ["//visibility:public"],
    cmd = " ".join([
        "/usr/bin/python3 -B -s $(location install.py)",
        "--qemu $(location //third_party/qemu:qemu-system-i386)",
        "--msdos $(location //third_party/msdos622:archive)",
        "--bp $(location //third_party/bp701:archive)",
        "--out $@",
    ]),
    tools = [
        "install.py",
        "qmp.py",
        "//third_party/qemu:qemu-system-i386",
    ],
)

# Boots the reference disk in a QEMU window. Changes are thrown away on exit.
python_tool(
    name = "run",
    data = [
        ":disk",
        "//third_party/qemu:qemu-system-i386",
    ],
    fixed_args = [
        "--qemu=$(rootpath //third_party/qemu:qemu-system-i386)",
        "--disk=$(rootpath :disk)",
    ],
    main = "run.py",
    srcs = ["qmp.py"],
)

# Compiles Pascal files with TPC on the reference machine and prints the
# results as JSON: bazel run //machine:probe -- file.pas ...
python_tool(
    name = "probe",
    data = [
        ":disk",
        "//machine/coverage",
        "//third_party/mtools",
        "//third_party/qemu:qemu-system-i386",
    ],
    fixed_args = [
        "--qemu=$(rootpath //third_party/qemu:qemu-system-i386)",
        "--mtools=$(rootpath //third_party/mtools)",
        "--disk=$(rootpath :disk)",
        "--coverage-plugin=$(rootpath //machine/coverage)",
    ],
    main = "probe.py",
    srcs = ["qmp.py"],
)

# Prints the tokens TPC's scanner delivers for each file:
# bazel run //machine:tokens -- file.pas|case.yaml ... [--out x.json]
python_tool(
    name = "tokens",
    data = [
        ":disk",
        "//spec:MACHINE.json",
        "//third_party/mtools",
        "//third_party/qemu:qemu-system-i386",
    ],
    fixed_args = [
        "--qemu=$(rootpath //third_party/qemu:qemu-system-i386)",
        "--mtools=$(rootpath //third_party/mtools)",
        "--disk=$(rootpath :disk)",
        "--machine=$(rootpath //spec:MACHINE.json)",
    ],
    main = "tokens.py",
    srcs = [
        "gdbremote.py",
        "probe.py",
        "qmp.py",
    ],
)

exports_files([
    "gdbremote.py",
    "probe.py",
    "qmp.py",
    "tokens.py",
])
